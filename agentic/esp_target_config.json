{
  "chip": "chips/esp32p4.json",
  "openocd": {
    "board_cfg": "board/esp32p4-builtin.cfg",
    "flash_command": "program_esp",
    "tcl_port": 6666,
    "gdb_port": 3333,
    "telnet_port": 4444
  },
  "flash": {
    "default_offsets": {
      "bootloader": "0x2000",
      "partition_table": "0x8000",
      "application": "0x10000"
    },
    "method": "serial",
    "serial": {
      "port": "auto",
      "baud": 2000000,
      "flash_mode": "dio",
      "flash_freq": "40m",
      "flash_size": "16MB"
    }
  },
  "toolchain": {
    "prefix": "riscv32-esp-elf-"
  },
  "gdb": {
    "executable": "riscv32-esp-elf-gdb-no-python"
  },
  "logging": {
    "method": "rtt"
  },
  "platform": "windows"
}
